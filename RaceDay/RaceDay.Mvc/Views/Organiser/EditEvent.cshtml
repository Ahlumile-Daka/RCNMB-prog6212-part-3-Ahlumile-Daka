@model EventFormVm
@{
    ViewData["Title"] = "Edit Event";
}
<h2 class="mb-4" style="color:var(--rd-primary)">Edit Event</h2>
<form asp-action="EditEvent" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="EventID" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row">
        <div class="col-md-8">
            <div class="card card-raceday mb-3">
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
                    {
                        <img src="@Model.BannerImageUrl" class="event-banner mb-3" alt="Banner" />
                    }
                    <div class="mb-3">
                        <label asp-for="EventName" class="form-label"></label>
                        <input asp-for="EventName" class="form-control" />
                        <span asp-validation-for="EventName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="EventDate" class="form-label"></label>
                            <input asp-for="EventDate" class="form-control" type="datetime-local" value="@Model.EventDate.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Location" class="form-label"></label>
                            <input asp-for="Location" class="form-control" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="DistanceKm" class="form-label"></label>
                            <input asp-for="DistanceKm" class="form-control" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="EventTypeID" class="form-label"></label>
                            <select asp-for="EventTypeID" class="form-select">
                                <option value="1">Running</option>
                                <option value="2">Walking</option>
                                <option value="3">Cycling</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="MaxParticipants" class="form-label"></label>
                            <input asp-for="MaxParticipants" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select">
                            <option>Open</option>
                            <option>Closed</option>
                            <option>Completed</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="BannerFile" class="form-label">Replace Banner Image</label>
                        <input asp-for="BannerFile" type="file" class="form-control" accept="image/*" />
                    </div>
                </div>
            </div>
            <button type="submit" class="btn btn-raceday">Save Changes</button>
            <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
