@model ResultEntryVm
@{
    ViewData["Title"] = "Results Entry";
}
<h2 class="mb-2" style="color:var(--rd-primary)">Results – @Model.EventName</h2>
<p class="text-muted mb-4">Capture finish times and positions for enrolled participants.</p>

<div class="row">
    <div class="col-md-5">
        <div class="card card-raceday mb-4">
            <div class="card-header bg-primary text-white">Capture Result</div>
            <div class="card-body">
                <form asp-action="CaptureResult" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="EventID" />
                    <div class="mb-3">
                        <label class="form-label">Participant</label>
                        <select asp-for="EnrolmentID" class="form-select" required>
                            <option value="">-- Select --</option>
                            @foreach (var en in Model.Enrolments)
                            {
                                var alreadyHas = Model.ExistingResults.Any(r => r.EnrolmentID == en.EnrolmentID);
                                <option value="@en.EnrolmentID" disabled="@(alreadyHas ? "disabled" : null)">
                                    @en.ParticipantName (@en.CategoryName) @(alreadyHas ? "✓ already entered" : "")
                                </option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="FinishTime" class="form-label"></label>
                        <input asp-for="FinishTime" class="form-control" placeholder="01:23:45" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Position" class="form-label"></label>
                        <input asp-for="Position" class="form-control" type="number" min="1" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label"></label>
                        <input asp-for="Notes" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-raceday">Save Result</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <h5>Existing Results</h5>
        @if (!Model.ExistingResults.Any())
        {
            <p class="text-muted">No results captured yet.</p>
        }
        else
        {
            <table class="table table-sm table-raceday">
                <thead>
                    <tr>
                        <th>Pos</th>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Finish Time</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model.ExistingResults.OrderBy(x => x.Position ?? 999))
                {
                    <tr>
                        <td>@(r.Position?.ToString() ?? "–")</td>
                        <td>@r.ParticipantName</td>
                        <td>@r.CategoryName</td>
                        <td>@(r.FinishTime?.ToString(@"hh\:mm\:ss") ?? "–")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
<a asp-action="Dashboard" class="btn btn-outline-secondary mt-3">Back to Dashboard</a>
